{
  "name": "newsfeed",
  "version": "0.0.0",
  "description": "Newsfeed Example",
  "private": true,
  "scripts": {
    "build": "webpack",
    "tsc": "tsc",
    "prettier": "prettier . --write",
    "lint": "eslint .",
    "print-schema": "node ./server/printSchema.mjs > ./server/schema.graphql",
    "relay": "relay-compiler",
    "watch-relay": "relay-compiler --watch",
    "watch-webpack": "webpack server",
    "watch-server": "nodemon ./server/index.mjs",
    "dev": "concurrently npm:watch-* -c auto",
    "grats": "grats",
    "sup-codegen": "supermassive generate-interfaces ./schema.graphql --output-dir=./src/supermassive",
    "sup-extract-schema": "supermassive extract-schema ./schema.graphql",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.20.5",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@graphitation/ts-codegen": "^2.15.0",
    "@graphql-tools/webpack-loader": "^7.0.0",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@types/react-relay": "^14.1.2",
    "@types/relay-runtime": "^14.1.5",
    "@typescript-eslint/eslint-plugin": "^5.45.1",
    "@typescript-eslint/parser": "^5.45.1",
    "babel-loader": "^9.1.0",
    "babel-plugin-relay": "^14.1.0",
    "concurrently": "^7.6.0",
    "css-loader": "^6.7.2",
    "eslint": "^8.29.0",
    "eslint-plugin-relay": "^1.8.3",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.7.2",
    "nodemon": "^2.0.20",
    "prettier": "^2.8.0",
    "relay-compiler": "^14.1.0",
    "typescript": "^5.5.3",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^4.11.1"
  },
  "dependencies": {
    "@graphitation/cli": "^1.16.0",
    "@graphitation/supermassive": "^3.8.3",
    "@graphql-tools/schema": "^10.0.18",
    "dataloader": "^2.2.3",
    "graphiql": "^2.2.0",
    "graphql": "^16.10.0",
    "grats": "^0.0.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-relay": "^18.2.0",
    "relay-runtime": "^18.2.0"
  }
}
